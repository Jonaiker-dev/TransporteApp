{
  "name": "transporteapp",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Transporte app",
  "author": "edgarjon1997 <edgarsuncion1997@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "node scripts/check-ui.mjs && prettier --write \"**/*.{js,ts,vue,css,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "node scripts/check-ui.mjs && prettier --check \"**/*.{js,ts,vue,css,html,md,json}\" --ignore-path .gitignore --ignore-path .prettierignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "check:ui": "node scripts/check-ui.mjs",
    "dev": "quasar dev",
    "dev:pwa": "quasar dev -m pwa",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.0.11",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.4.299",
    "pdfmake": "^0.2.23",
    "pinia": "^4.0.2",
    "quasar": "^2.35.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.19.11",
    "@types/pdfmake": "^0.2.13",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.4.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
